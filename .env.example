APP_ENV=development
DATABASE_URL=postgresql://user:pass@localhost:5432/sacco
CONVERSATION_RETENTION_DAYS=90

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

NGROK_AUTHTOKEN=

# ----------------------------------------------------------------------
# RAG / Retrieval infrastructure (System 4)
# ----------------------------------------------------------------------
# Qdrant connection. Leave QDRANT_URL empty to use an in-memory instance
# (tests + lightweight local dev). Set to the Docker/remote URL to use a
# standalone Qdrant server, e.g. http://localhost:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=sacco_knowledge

# Embedding model (sentence-transformers). Runs locally; not NVIDIA.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

RAG_TOP_K=5
RAG_MIN_SCORE=0.2
RAG_ANSWER_MAX_TOKENS=500
RAG_ANSWER_TEMPERATURE=0.2

# Chunking (character based with overlap)
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_CHUNK_MIN_SIZE=200

# Identifier for the demo SACCO used before real multi-tenant content exists.
DEFAULT_SACCO_ID=demo_sacco
